<Window x:Class="PairProgram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PairProgram"
        mc:Ignorable="d"
        Title="Управление пользователями" Height="420" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <StackPanel x:Name="AuthPanel" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Логин:"/>
            <TextBox x:Name="LoginTextBox" Margin="0,3,0,10" Padding="3"/>

            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="PassBox" Margin="0,3,0,15" Padding="3"/>

            <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" Height="30" Margin="0,0,0,5"/>
            <Button x:Name="RegisterButton" Content="Регистрация" Click="RegisterButton_Click" Height="30"/>
        </StackPanel>

        <Grid x:Name="DataPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Список пользователей" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <ListBox Grid.Row="1" x:Name="UsersListBox" Margin="0,0,0,10"/>

            <Grid Grid.Row="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ImportButton" Grid.Column="0" Content="Импорт CSV" Click="ImportButton_Click" Height="28" Margin="0,0,3,0"/>
                <Button x:Name="ExportButton" Grid.Column="1" Content="Экспорт CSV" Click="ExportButton_Click" Height="28" Margin="3,0,0,0"/>
            </Grid>

            <Button x:Name="LogoutButton" Grid.Row="3" Content="Выйти" Click="LogoutButton_Click" Height="28"/>
        </Grid>
    </Grid>
</Window>